# Admin auth (server-only — no NEXT_PUBLIC_ prefix, never commit real values).
# Generate with: npm run admin:hash "Your Strong Password Here" [username]
# Then restart the app (`npm start` / pm2 restart). No rebuild needed for env.
ADMIN_USERNAME=
ADMIN_SALT=
ADMIN_HASH=
# Random 64-hex secret signing session cookies. Rotate + restart to kill all sessions.
ADMIN_SESSION_SECRET=
# Optional: override where password changes persist (default: ./data).
# ADMIN_DATA_DIR=/var/lib/amda

# Telegram notifications (server-only). Create the bot with @BotFather, add it
# to the group, then run: node scripts/telegram-chat-id.mjs
TELEGRAM_BOT_TOKEN=
# Where new website enquiries go. Group ids are negative, e.g. -1001234567890.
TELEGRAM_CHAT_ID=
# Optional: separate group for deploy/server alerts. Defaults to TELEGRAM_CHAT_ID.
TELEGRAM_ALERT_CHAT_ID=
