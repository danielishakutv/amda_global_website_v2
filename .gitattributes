# Shell scripts and server includes run on Linux. Without this, a checkout on
# Windows rewrites them with CRLF and bash fails with
# "syntax error near unexpected token `$'{\r'`" the moment they are copied to
# the box. Keep them LF everywhere.
*.sh    text eol=lf
*.inc   text eol=lf
*.py    text eol=lf
*.mjs   text eol=lf
*.yml   text eol=lf
